{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Disable AutoMapper >= 15",
      "matchPackageNames": ["AutoMapper", "automapper"],
      "allowedVersions": "<15"
    }
  ]
}
